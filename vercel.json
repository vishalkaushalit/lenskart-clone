{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run vercel:install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "/robots\\.txt",
      "dest": "/api/index.js"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/api/index.js"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/products/.*",
      "status": 404
    },
    {
      "src": "/admin(?:/.*)?",
      "dest": "/admin/index.html"
    },
    {
      "src": "/.*",
      "dest": "/api/index.js"
    }
  ],
  "regions": [
    "bom1"
  ]
}
